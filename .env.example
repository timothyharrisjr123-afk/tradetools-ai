# FieldDive environment contract (names only — never commit secrets)

# Copy to `.env.local` for local development. Do not commit `.env.local`.
# See `docs/beta-trust-ops.md` for development / preview / controlled-beta rules.

# =============================================================================
# REQUIRED CORE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin for customer-facing links (proposal email, /p/{token}, payment returns).
# Development: http://localhost:3000 is legal.
# Preview / production / controlled beta: MUST be absolute https://… and MUST NOT be localhost.
# Non-development never falls back to Host / Origin headers (fail closed).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# REQUIRED SEND (proposal email via Resend)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM=

# =============================================================================
# REQUIRED TEST PAYMENTS (Stripe Connect — TEST/SANDBOX only for controlled beta)
# =============================================================================
# Connect money path refuses sk_live_ keys in code. Do not unlock live money in Trust Ops.
STRIPE_SECRET_KEY=
# Not currently read by app runtime (hosted Checkout / Connect links); keep aligned with Stripe TEST
# Dashboard for future client Stripe.js and operator clarity.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Preferred Connect webhook signing secret for POST /api/webhooks/stripe/connect
STRIPE_CONNECT_WEBHOOK_SECRET=

# Fallback only: Connect verifier may use STRIPE_WEBHOOK_SECRET when CONNECT secret is unset.
# Prefer setting STRIPE_CONNECT_WEBHOOK_SECRET explicitly. Also used by legacy /api/payments/webhook.
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# OPS / VERIFICATION (not required for Next.js request path)
# =============================================================================
# Direct Postgres URL for operator migration verification only — never expose to browser.
# DATABASE_URL=

# Escape hatch: force proposal send-freeze RPC path when set to 1 (ops/debug).
# USE_PROPOSAL_SEND_FREEZE_RPC=

# Escape hatches (default off — do not enable in controlled beta unless debugging):
# USE_CREATE_DRAFT_PROPOSAL_SEQUENTIAL=1
# USE_REFRESH_DRAFT_PRICING_SEQUENTIAL=1

# =============================================================================
# OPTIONAL PRODUCT CAPABILITY
# =============================================================================
# Google Places (New) — server-only; never NEXT_PUBLIC_
# Enable Places Autocomplete (New) + Place Details (New) for the key.
# Without these, New Job manual address intake continues quietly.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# OpenAI — AI/proposal-copy helpers (not required for first-proposal beta spine)
# OPENAI_API_KEY=

# =============================================================================
# LEGACY (do not use for Job Card Connect beta money)
# =============================================================================
# Vercel KV / Upstash — legacy estimate approval links
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
